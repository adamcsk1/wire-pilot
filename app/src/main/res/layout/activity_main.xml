<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/screenRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/surface"
  android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/homeToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    app:title="@string/app_name"
    app:titleTextColor="@color/copper" />

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/statusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="14sp" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/applyNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/apply_now" />

          <TextView
            android:id="@+id/applyNowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vpn_background_hint"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/controlSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/control_section"
        android:textColor="@color/on_surface" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/pauseButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/control_pause" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/vpnSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/connect_vpn"
        android:textColor="@color/on_surface" />

      <TextView
        android:id="@+id/manualVpnHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/manual_vpn_hint"
        android:textColor="@color/on_surface_muted"
        android:textSize="13sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/tunnel_section"
        android:textColor="@color/on_surface"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/activeTunnelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/selectTunnelButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/select_tunnel" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/importTunnelButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/import_tunnel" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/exportTunnelButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_tunnels" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/splitTunnelButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/split_tunnel" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ssid_section"
        android:textColor="@color/on_surface"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/emptySsids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ssid_empty"
        android:textColor="@color/on_surface_muted" />

      <LinearLayout
        android:id="@+id/ssidList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/addCurrentButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/add_current_ssid_unavailable" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/addSsidButton"
        style="@style/Widget.WirePilot.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_ssid_manual" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/connectOnMobileSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/connect_on_mobile"
        android:textColor="@color/on_surface" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
