<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/screenRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/surface"
  android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/usageToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    app:navigationIcon="?attr/homeAsUpIndicator"
    app:navigationIconTint="@color/on_surface"
    app:title="@string/usage_title"
    app:titleTextColor="@color/on_surface" />

  <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/usageSwitch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:text="@string/usage_enabled"
    android:textColor="@color/on_surface" />

  <TextView
    android:id="@+id/usageHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="8dp"
    android:text="@string/usage_disabled_hint"
    android:textColor="@color/on_surface_muted"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/usageNumbers"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/usage_received"
      android:textColor="@color/on_surface_muted"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/usageRx"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="@color/on_surface"
      android:textSize="28sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/usage_sent"
      android:textColor="@color/on_surface_muted"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/usageTx"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="@color/on_surface"
      android:textSize="28sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
